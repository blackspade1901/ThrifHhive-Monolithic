# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the Express server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# MongoDB Atlas connection string.
# Create a free cluster at https://www.mongodb.com/cloud/atlas, add a database
# user, allow your current IP (or 0.0.0.0/0 for lab purposes), then copy the
# "Connect your application" URI here. Include the database name in the path,
# e.g. .../thrifthive?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/thrifthive?retryWrites=true&w=majority

# Origin allowed to call this API (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Minimum log level for the logger: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
